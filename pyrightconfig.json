{
  "venvPath": ".devenv/state",
  "venv": "venv",
  "pythonVersion": "3.13",
  "include": [
    "src",
    "."
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".venv",
    ".devenv",
    ".git"
  ],
  "typeCheckingMode": "basic",
  "useLibraryCodeForTypes": true,
  "autoImportCompletions": true,
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "warning"
}
